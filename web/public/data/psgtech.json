                {
                  "code": "20CS101",
                  "name": "Problem Solving and Programming in C",
                  "credits": "4",
                  "chapters": [
                    {
                      "unit": "Unit 1",
                      "title": "Introduction to Problem Solving",
                      "topics": [
                        "Algorithms",
                        "Flowcharts",
                        "Pseudocode",
                        "Structured programming approach"
                      ]
                    },
                    {
                      "unit": "Unit 2",
                      "title": "C Programming Basics",
