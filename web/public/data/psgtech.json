                        "Function definitions",
                        "Parameter passing",
                        "Recursion",
                        "Storage classes"
                      ]
                    },
                    {
                      "unit": "Unit 4",
                      "title": "Pointers and Structures",
                      "topics": [
                        "Pointer arithmetic",
                        "Dynamic memory allocation",
                        "Structures",
                        "Unions"
                      ]
                    },
                    {
                      "unit": "Unit 5",
                      "title": "File Handling",
                      "topics": [
                        "File I/O",
                        "Command line arguments",
                        "Preprocessor directives"
                      ]
                    }
                  ]
                },
                {
                  "code": "20MA101",
                  "name": "Matrices and Calculus",
                  "credits": "4",
                  "chapters": [
                    {
                      "unit": "Unit 1",
                      "title": "Matrices",
                      "topics": [
                        "Eigenvalues",
                        "Eigenvectors",
                        "Cayley-Hamilton theorem",
                        "Diagonalization"
                      ]
                    },
                    {
                      "unit": "Unit 2",
                      "title": "Differential Calculus",
                      "topics": [
                        "Curvature",
                        "Evolutes",
                        "Partial derivatives",
                        "Maxima and minima"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "semester": 2,
              "subjects": [
                {
                  "code": "20CS102",
                  "name": "Data Structures",
                  "credits": "4",
                  "chapters": [
                    {
                      "unit": "Unit 1",
                      "title": "Linear Data Structures",
                      "topics": [
                        "Arrays",
                        "Linked lists",
                        "Stacks",
                        "Queues"
                      ]
                    },
                    {
                      "unit": "Unit 2",
                      "title": "Non-Linear Data Structures",
                      "topics": [
                        "Trees",
                        "Binary search trees",
                        "AVL trees",
                        "Heaps"
                      ]
                    },
                    {
                      "unit": "Unit 3",
                      "title": "Graphs",
                      "topics": [
                        "Graph representations",
                        "BFS",
                        "DFS",
                        "Shortest path algorithms"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
